# microservice specific routes

POST       /registration/individual     uk.gov.hmrc.securitiestransferchargeregistration.controllers.RegistrationController.registerIndividual

POST       /subscription                    uk.gov.hmrc.securitiestransferchargeregistration.controllers.SubscriptionController.createSubscription
GET        /subscription/:subscriptionId     uk.gov.hmrc.securitiestransferchargeregistration.controllers.SubscriptionController.viewSubscription(subscriptionId: String)
PUT       /subscription/:subscriptionId     uk.gov.hmrc.securitiestransferchargeregistration.controllers.SubscriptionController.amendSubscription(subscriptionId: String)

POST       /enrolment/individual        uk.gov.hmrc.securitiestransferchargeregistration.controllers.EnrolmentController.enrolIndividual
POST       /enrolment/organisation        uk.gov.hmrc.securitiestransferchargeregistration.controllers.EnrolmentController.enrolOrganisation

